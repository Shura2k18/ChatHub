@import "src/Colors";

.container {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 2;
  width: 100vw;
  height: var(--viewport-height);
  display: flex;
  justify-content: center;
  align-items: center;

  .close {
    cursor: pointer;
    position: fixed;
    display: flex;
    justify-content: center;
    align-items: center;
    top: 0;
    right: 0;
    z-index: 3;
    transition: none;

    path {
      fill-opacity: 0.8;
      fill: $white;
    }

    &:hover {
      path {
        fill-opacity: 1;
        fill: var(--color);
      }
    }
  }
  .carousel {
    z-index: 2;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;

    .slide {
      max-width: 80%;
      height: 80%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      .slideCounter {
        margin-top: 2%;
        color: $white;
      }

      img {
        max-width: 100%;
        max-height: 100%;
      }
    }
  }
}